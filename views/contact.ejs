<!DOCTYPE html>
<html>
<head>
    <title>Contact Form</title>
</head>
<body>
    <h2>Contact Form</h2>

    <form action="/contact" method="POST">
        Name: <input type="text" name="name"><br><br>
        Email: <input type="email" name="email"><br><br>
        Message:<br>
        <textarea name="message"></textarea><br><br>
        <button type="submit">Submit</button>
    </form>

</body>
</html>
