
<!DOCTYPE html>
<html>
<head>
    <title>Blog</title>
</head>
<body>
    <h2>Blog Posts</h2>

    <a href="/blog/new">Create New Post</a>

    <ul>
        <% posts.forEach(function(post){ %>
            <li>
                <a href="/blog/<%= post.id %>"><%= post.title %></a>
            </li>
        <% }); %>
    </ul>

</body>
</html>
